# ==============================================================================
# Configuration Backend (.NET 8 Minimal API)
# ==============================================================================
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://127.0.0.1:5000

# Chaîne de connexion SQLite locale (créée automatiquement au démarrage)
ConnectionStrings__DefaultConnection="Data Source=fraisroute.db"

# Activation de l'interface Swagger UI (/swagger)
EnableSwagger=true

# Origines CORS autorisées (séparées par index de configuration .NET si surchargées)
Cors__AllowedOrigins__0=http://localhost:5173
Cors__AllowedOrigins__1=http://127.0.0.1:5173
Cors__AllowedOrigins__2=capacitor://localhost

# ==============================================================================
# Configuration Frontend (Vue 3 + Vite + Capacitor)
# ==============================================================================
# URL de l'API Backend (par défaut '/api' via le proxy Vite en développement web,
# ou URL complète ex: 'http://10.0.2.2:5000/api' pour émulateur Android)
VITE_API_URL=/api
